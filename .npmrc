# SABI install policy.
#
# The Capacitor 8 toolchain, the Vite 6 React plugin and Testing Library all
# declare peer ranges that npm 10 resolves differently on a clean machine than it
# does against an existing node_modules. CI already installs with
# `--legacy-peer-deps` (see .github/workflows/build-android-apk.yml); declaring it
# here makes local, Vercel and CI installs behave identically so a deploy can not
# fail with ERESOLVE while `npm install` works on a developer laptop.
legacy-peer-deps=true

# Reduce install-log noise so a real failure is visible in the deploy log.
fund=false
audit=false
