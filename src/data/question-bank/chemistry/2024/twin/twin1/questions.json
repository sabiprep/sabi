      "topic": "Gas Laws",
      "subtopic": "Boyle's Law",
      "question": "A gas occupies 250 cm³ at 1 atm pressure. Calculate its volume at 2 atm pressure at constant temperature.",
      "options": {
        "A": "125 cm³",
        "B": "500 cm³",
        "C": "250 cm³",
        "D": "100 cm³"
      },
      "answer": "A",
      "explanation": "P1V1 = P2V2 => 1 * 250 = 2 * V2 => V2 = 125 cm³.",
      "explanation_short": "V2 = (1 * 250) / 2 = 125 cm³.",
      "explanation_pidgin": "Pressure double from 1 atm to 2 atm, so volume go divide by 2: 250 / 2 = 125 cm³."
    }
  ]
}
