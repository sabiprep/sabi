# ---------------------------------------------------------------------------
# SABI server configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# AI stays disabled until providers, prices, privacy terms and limits are verified.
SABI_AI_ENABLED=false
SABI_AI_POLICY_VERSION=2026-11-08-v1
SABI_AI_CREDITS_ENABLED=false
SABI_AI_PROVIDER_ORDER=gemini,openai,anthropic,openrouter
# Optional task-specific overrides:
# SABI_AI_EXPLANATION_PROVIDER_ORDER=gemini,openrouter,openai
# SABI_AI_TUTOR_CHAT_PROVIDER_ORDER=groq,gemini,openai

# Prices are USD per 1,000,000 tokens. Unknown prices are ranked after priced providers.
# These are operator-supplied snapshots: verify current vendor pricing before enabling.
# SABI_GEMINI_INPUT_PRICE_PER_MILLION=0
# SABI_GEMINI_OUTPUT_PRICE_PER_MILLION=0
# SABI_OPENAI_INPUT_PRICE_PER_MILLION=
# SABI_OPENAI_OUTPUT_PRICE_PER_MILLION=
# SABI_OPENROUTER_INPUT_PRICE_PER_MILLION=
# SABI_OPENROUTER_OUTPUT_PRICE_PER_MILLION=

# Native provider credentials; secrets remain server-side.
GEMINI_API_KEY=
SABI_GEMINI_MODEL=
OPENAI_API_KEY=
SABI_OPENAI_MODEL=
ANTHROPIC_API_KEY=
SABI_ANTHROPIC_MODEL=

# Any additional provider ID in SABI_AI_PROVIDER_ORDER can use the OpenAI-compatible
# chat-completions adapter. ID is normalized to uppercase for environment names.
# Example: OPENROUTER_API_KEY + SABI_OPENROUTER_MODEL + SABI_OPENROUTER_BASE_URL.
# SABI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GROQ_API_KEY=
# SABI_GROQ_MODEL=
# SABI_GROQ_BASE_URL=https://api.groq.com/openai/v1
# CEREBRAS_API_KEY=
# SABI_CEREBRAS_MODEL=
# SABI_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# DEEPSEEK_API_KEY=
# SABI_DEEPSEEK_MODEL=
# SABI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LOCAL_API_KEY=not-required-by-some-local-gateways
# SABI_LOCAL_MODEL=
# SABI_LOCAL_BASE_URL=http://127.0.0.1:11434/v1

# Optional task-specific model overrides:
# SABI_GEMINI_EXPLANATION_MODEL=
# SABI_OPENAI_TUTOR_CHAT_MODEL=
# SABI_OPENROUTER_CONTENT_DRAFT_MODEL=

# Supabase (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

SABI_APP_URL=https://your-app.example.com
ALLOWED_ORIGINS=
SABI_INSTANT_VERIFY=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# AUTH_RATE_LIMIT_MAX=10
# AI_RATE_LIMIT_MAX=20
# MAX_JSON_BODY=256kb
# VITE_API_BASE_URL=https://sabi-api-<project>.europe-west1.run.app
# VITE_PUBLIC_APP_URL=https://sabi.vercel.app

SABI_PAYMENT_ENABLED=false
SABI_PAYMENT_PROVIDER=
SABI_PAYMENT_CALLBACK_URL=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLW_SECRET_HASH=

NOTIFICATION_WORKER_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Sabi
TERMII_API_KEY=
TERMII_SENDER_ID=
# FCM_PROJECT_ID=
# FCM_ACCESS_TOKEN=
