# ---------------------------------------------------------------------------
# SABI server configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# AI is optional. Core learning never depends on a model provider.
# Keep disabled until credentials and model IDs have been configured and tested.
SABI_AI_ENABLED=false
SABI_AI_POLICY_VERSION=2026-11-08-v1
SABI_AI_PROVIDER_ORDER=gemini,openai,anthropic
# Optional task-specific order overrides:
# SABI_AI_EXPLANATION_PROVIDER_ORDER=gemini,openai
# SABI_AI_TUTOR_CHAT_PROVIDER_ORDER=gemini,anthropic

# Provider credentials are server-side only; never use VITE_ prefixes.
GEMINI_API_KEY=
SABI_GEMINI_MODEL=
# Optional task-specific model overrides:
# SABI_GEMINI_EXPLANATION_MODEL=
# SABI_GEMINI_TUTOR_CHAT_MODEL=
# SABI_GEMINI_CONTENT_DRAFT_MODEL=
OPENAI_API_KEY=
SABI_OPENAI_MODEL=
# Optional task-specific model overrides:
# SABI_OPENAI_EXPLANATION_MODEL=
# SABI_OPENAI_TUTOR_CHAT_MODEL=
# SABI_OPENAI_CONTENT_DRAFT_MODEL=
ANTHROPIC_API_KEY=
SABI_ANTHROPIC_MODEL=
# Optional task-specific model overrides:
# SABI_ANTHROPIC_EXPLANATION_MODEL=
# SABI_ANTHROPIC_TUTOR_CHAT_MODEL=
# SABI_ANTHROPIC_CONTENT_DRAFT_MODEL=

# Supabase (Dashboard -> Project Settings -> API)
# The service-role key is REQUIRED by the API outside of tests. The server refuses
# to boot in production without it; on a serverless host (Vercel) it instead logs
# the error and answers 503 API_NOT_CONFIGURED. It bypasses RLS, so keep it
# server-side only (never through a VITE_ var, those are baked into the bundle).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional alias for VITE_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY used by the server.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# Public URL of the web app. Used as the password-recovery redirect target.
SABI_APP_URL=https://your-app.example.com

# Comma separated extra CORS origins (production web app, preview URLs, ...).
# localhost, the Capacitor WebView (capacitor://localhost, https://localhost) and
# sabi*.vercel.app are always allowed.
ALLOWED_ORIGINS=

# Set to "false" to stop the server from confirming new accounts immediately after
# sign-up (use once the email OTP / verification flow is enabled in Phase 1).
SABI_INSTANT_VERIFY=true

# Rate limiting (optional overrides)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# AUTH_RATE_LIMIT_MAX=10
# AI_RATE_LIMIT_MAX=20

# Maximum JSON request body size (default 256kb)
# MAX_JSON_BODY=256kb

# Base URL of the SABI API when it is NOT served from the same origin as the web
# app (e.g. web app on Vercel + API on Cloud Run, or the Capacitor Android APK).
# Leave EMPTY for the normal same-origin deployment: the browser then calls
# /api/* on whatever host serves the app.
# It must be the host that runs `server.ts` and answers JSON on /api/health —
# never a static/SPA host and never an AI Studio preview proxy
# (https://ais-pre-….run.app answers /api/* with 302 -> /__cookie_check.html).
# VITE_API_BASE_URL=https://sabi-api-<project>.europe-west1.run.app

# Public origin of the web app, used as the Supabase email-confirmation / OAuth
# return address. Optional: when unset, the app uses its own origin, and if that
# is not public (localhost, 10.x, Android WebView) Supabase falls back to the
# Auth "Site URL" from the dashboard (docs/runbooks/phase0-rollout.md §4a).
# VITE_PUBLIC_APP_URL=https://sabi.vercel.app


# Payments: choose a provider and configure secrets only after business approval.
# No plans are seeded; prices and feature entitlements must be approved in the admin catalogue.
SABI_PAYMENT_ENABLED=false
# SABI_PAYMENT_PROVIDER=paystack
# SABI_PAYMENT_PROVIDER=flutterwave
SABI_PAYMENT_PROVIDER=
SABI_PAYMENT_CALLBACK_URL=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLW_SECRET_HASH=
